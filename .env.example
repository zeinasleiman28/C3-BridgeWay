# Copy this file to .env and put your real keys there. NEVER commit .env!

# Which AI provider to use: gemini or openai
LLM_PROVIDER=gemini

# Only the key for your chosen provider is needed
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Optional: override the default model (gemini-3.5-flash-lite / gpt-4o-mini)
# LLM_MODEL=

# Optional: reflection (a second model call that checks each reply). true by default
# USE_REFLECTION=true
